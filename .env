# ============================================================
# Variabel untuk docker-compose.yml (BUKAN .env aplikasi Laravel,
# itu ada di src/.env). File ini yang dibaca docker-compose lewat
# ${VARIABEL} di docker-compose.yml.
#
# PENTING: file ini JANGAN pernah di-commit ke Git / dibagikan.
# Tambahkan ".env" ke .gitignore di root project kalau belum ada.
# ============================================================

APP_KEY=base64:UP2Ir9QSGsf84kvlU2NbEGGk+BvWlwkzkR4BOBdhABA=

# Ganti ke domain asli begitu sudah punya (lihat catatan HTTPS di chat)
APP_URL=https://antrian-papyrus-jogja.duckdns.org:8493

# --- Database ---
# TODO: password ini sebelumnya sempat tertulis polos di docker-compose.yml
# yang sudah diupload — sangat disarankan GANTI password ini sebelum
# lanjut ke production sungguhan.
DB_DATABASE=papyrus_antrian
DB_USERNAME=papyrus_user
DB_PASSWORD="#Td500mblue!"
DB_ROOT_PASSWORD="#Td500mblue!"

# --- Reverb (WebSocket) ---
REVERB_APP_ID=antriyuk
REVERB_APP_KEY=antriyuklocalkey
REVERB_APP_SECRET=antriyuklocalsecret
REVERB_SCHEME=https

# --- Alamat publik yang dipakai BROWSER pelanggan buat connect Reverb ---
# Ganti PUBLIC_HOST ke domain kamu begitu sudah ada (bukan IP lagi)
PUBLIC_HOST=antrian-papyrus-jogja.duckdns.org
PUBLIC_REVERB_PORT=8493

# --- WAJIB diisi juga (VITE_*): Vite cuma mau expose variabel yang diawali
# 'VITE_' ke kode JS (import.meta.env.VITE_...). PUBLIC_HOST/PUBLIC_REVERB_PORT
# di atas TIDAK terbaca oleh JS sama sekali, meski isinya sama persis — makanya
# WebSocket-nya selama ini nyasar ke 'localhost' (nilai default kalau variabel
# ini kosong). Kalau PUBLIC_HOST/PUBLIC_REVERB_PORT diganti, baris di bawah ini
# WAJIB ikut diganti juga (harus sama persis).
VITE_REVERB_APP_KEY=antriyuklocalkey
VITE_REVERB_HOST=103.150.226.74
VITE_REVERB_PORT=8493
VITE_REVERB_SCHEME=https

